{
  "name": "gpawa-consumer-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "build:debug": "tsc --noEmit && vite build --mode android-debug",
    "android:add": "cap add android",
    "android:sync:debug": "npm run build:debug && CAPACITOR_DEBUG_HTTP=1 cap sync android",
    "android:sync:release": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
