# Append these names to the PRIVATE hosting environment, not the repository.
# Off until migration 0031 + cryptography + backed-up private keys are ready.
ENERGY_TOKEN_ISSUANCE_ENABLED=false
ENERGY_TOKEN_ENCRYPTION_KEYS=<PRIVATE_FERNET_KEY_BASE64URL_32_BYTES>
ENERGY_TOKEN_LOOKUP_KEY=<PRIVATE_RANDOM_AT_LEAST_32_CHARACTERS_KEEP_STABLE>
# Hosted consumer token display does NOT authorize any physical/bench transport.
BENCH_DEVICE_ENABLED=false
# Keep all seven FEATURE_* flags and existing physical/core restrictions false.
