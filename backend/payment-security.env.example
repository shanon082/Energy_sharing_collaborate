# Required for deployment; use secret-manager values, never commit real values.
DEBUG=false
SECRET_KEY=
DB_PASSWORD=
EMAIL_HOST_PASSWORD=
THINGSBOARD_WEBHOOK_SECRET=

# New verified UGX phone payments remain unavailable until all settings below
# are provisioned for the actual production provider endpoint.
MTN_ENVIRONMENT=production
MTN_BASE_URL=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER_ID=
MTN_API_KEY=
MTN_USE_SIMULATED_PAYMENTS=false

# Development-only, database-backed simulator. Both DEBUG and this flag must
# be true; use an unrelated secret solely for simulated device enrollment.
SIMULATED_METER_ENABLED=false
SIMULATOR_DEVICE_TOKEN=

# Keep the seven deferred features disabled; see docs/FEATURE_FLAGS.md.
FEATURE_PEER_SHARING_ENABLED=false
FEATURE_METER_TRANSFERS_ENABLED=false
FEATURE_THIRD_PARTY_REPAYMENT_ENABLED=false
FEATURE_USSD_ENABLED=false
FEATURE_WALLET_DEPOSITS_ENABLED=false
FEATURE_WALLET_WITHDRAWALS_ENABLED=false
FEATURE_EXTERNAL_CRB_ENABLED=false
