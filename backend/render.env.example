# Set individually in the Render dashboard. Never upload backend/.env.
PYTHON_VERSION=3.12.15
DJANGO_SETTINGS_MODULE=backend.render_settings
DJANGO_LOAD_LOCAL_ENV=false
DEBUG=False
SECRET_KEY=<new-random-Django-secret-at-least-50-characters>
# Automatically supplied by Render; example only, do not override with a URL.
RENDER_EXTERNAL_HOSTNAME=<assigned-backend-name>.onrender.com
EXTRA_ALLOWED_HOSTS=
BASE_URL=https://<assigned-backend-name>.onrender.com/api/v1
FRONTEND_URL=https://<existing-nextjs-web-hostname>
PRODUCTION_ORIGIN=https://<existing-nextjs-web-hostname>
# Current debug APK. A release APK uses https://localhost instead.
MOBILE_APP_ORIGIN=http://localhost

# Render PostgreSQL individual fields, NOT DATABASE_URL. Use a fresh test DB.
DB_NAME=<render-test-database-name>
DB_USER=<render-test-database-user>
DB_PASSWORD=<render-test-database-password>
DB_HOST=<internal-render-postgres-hostname>
DB_PORT=5432
# Private same-region Render URL: prefer. External connections: require or stricter.
DB_SSLMODE=prefer

# A private Render Key Value URL. Use the same values on the worker service.
CELERY_BROKER_URL=redis://<internal-render-key-value-hostname>:6379/0
REDIS_URL=redis://<internal-render-key-value-hostname>:6379/0
CELERY_RESULT_BACKEND=redis://<internal-render-key-value-hostname>:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TIMEZONE=Africa/Nairobi

EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<new-smtp-password-or-app-password>
DEFAULT_EMAIL_SENDER=<verified-sender-address>
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

FEATURE_PEER_SHARING_ENABLED=false
FEATURE_METER_TRANSFERS_ENABLED=false
FEATURE_THIRD_PARTY_REPAYMENT_ENABLED=false
FEATURE_USSD_ENABLED=false
FEATURE_WALLET_DEPOSITS_ENABLED=false
FEATURE_WALLET_WITHDRAWALS_ENABLED=false
FEATURE_EXTERNAL_CRB_ENABLED=false
MOBILE_PAYMENT_ACTIONS_ENABLED=false
SIMULATED_METER_ENABLED=false
MTN_USE_SIMULATED_PAYMENTS=false
AMI_GATEWAY=utils.ami_gateway.MockAMIGateway
CRB_PROVIDER=loan.crb.NoOpCreditBureauProvider
WEB_CONCURRENCY=1
