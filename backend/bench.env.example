# A SEPARATE private 0600 file outside the checkout; never use hosted credentials.
SECRET_KEY=<FRESH_RANDOM_BENCH_SECRET_AT_LEAST_50_CHARACTERS>
BENCH_DEVICE_ENABLED=true
BENCH_DATABASE_NAME=gpawa_bench_keypad
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=<DEDICATED_LOCAL_BENCH_ROLE>
DB_PASSWORD=<PRIVATE_LOCAL_BENCH_PASSWORD>
DB_SSLMODE=prefer
ENERGY_TOKEN_ISSUANCE_ENABLED=true
ENERGY_TOKEN_ENCRYPTION_KEYS=<BENCH_ONLY_FERNET_KEY>
ENERGY_TOKEN_LOOKUP_KEY=<BENCH_ONLY_RANDOM_AT_LEAST_32_CHARACTERS>
# Supply BENCH_DEVICE_TOKEN privately per provisioned device, not here globally.
# backend.bench_settings forces LOCAL_DEMO, no provider/ThingsBoard transport,
# seven deferred flags false, no Celery eager mode and no physical delivery.
