# PLACEHOLDERS ONLY for credentials/assigned addresses: replace privately on host.
# File: /home/<account>/.config/energy-sharing/backend.env (0600, directory 0700).
# Do not put this private file in the backend directory or upload a local .env.
SECRET_KEY=<fresh-random-deployment-secret-at-least-50-characters>
ALWAYSDATA_HOSTNAME=<assigned-alwaysdata-hostname>
# No Next.js host required. Account pages use https://ALWAYSDATA_HOSTNAME.
# Optional future web URL (omit this key entirely until a web app is hosted):
# FRONTEND_URL=<https-url-of-existing-nextjs-web-app>
# Optional HTTPS web origin override; defaults to backend origin without FRONTEND_URL.
# PRODUCTION_ORIGIN=<https-web-origin-without-trailing-slash>
# EXTRA_ALLOWED_HOSTS=<comma-separated-additional-explicit-hostnames>
# BASE_URL=<https-api-base-url-ending-in-api/v1>
DB_HOST=<assigned-postgresql-host>
DB_NAME=<isolated-testing-database>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_PORT=5432
DB_SSLMODE=require
# DB_SSLROOTCERT=<absolute-ca-file-for-verify-ca-or-verify-full>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=shanonsimon082@gmail.com
EMAIL_HOST_PASSWORD=<new-gmail-app-password-enter-privately>
DEFAULT_EMAIL_SENDER=shanonsimon082@gmail.com
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# Safety constants; the settings profile rejects enabled or malformed flags.
DEBUG=false
DJANGO_LOAD_LOCAL_ENV=false
CELERY_TASK_ALWAYS_EAGER=false
MTN_USE_SIMULATED_PAYMENTS=false
SIMULATED_METER_ENABLED=false
MOBILE_PAYMENT_ACTIONS_ENABLED=false
FEATURE_PEER_SHARING_ENABLED=false
FEATURE_METER_TRANSFERS_ENABLED=false
FEATURE_THIRD_PARTY_REPAYMENT_ENABLED=false
FEATURE_USSD_ENABLED=false
FEATURE_WALLET_DEPOSITS_ENABLED=false
FEATURE_WALLET_WITHDRAWALS_ENABLED=false
FEATURE_EXTERNAL_CRB_ENABLED=false
AMI_GATEWAY=utils.ami_gateway.MockAMIGateway
CRB_PROVIDER=loan.crb.NoOpCreditBureauProvider
# No provider, physical device, Redis or Celery credentials belong here.
