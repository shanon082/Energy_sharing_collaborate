# Overlay on alwaysdata.env.example in the PRIVATE host file, never upload secrets.
# Opt-in profile: backend.alwaysdata_sandbox_settings, sandbox WSGI file below.
# Meter0029 enables immediate SELF_DECLARED prototype enrollment in this profile.
# No pre-created inventory, staff approval or simulator is required for new meters.
# Keep the existing fresh SECRET_KEY, DB_* and account email configuration.
ALWAYSDATA_HOSTNAME=shanonsimon.alwaysdata.net
BASE_URL=https://shanonsimon.alwaysdata.net/api/v1
DB_NAME=shanonsimon_energy_test
DB_USER=shanonsimon
DB_HOST=postgresql-shanonsimon.alwaysdata.net
DB_PORT=5432
DB_PASSWORD=<PRIVATE_DATABASE_PASSWORD>
DB_SSLMODE=require
SECRET_KEY=<PRIVATE_FRESH_SECRET_KEEP_EXISTING_WORKING_VALUE>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=shanonsimon082@gmail.com
EMAIL_HOST_PASSWORD=<PRIVATE_GMAIL_APP_PASSWORD>
DEFAULT_EMAIL_SENDER=shanonsimon082@gmail.com
# FRONTEND_URL optional; verification/reset use the configured Django HTTPS host.
# Keep existing valid MTN credentials private and dormant; do not reprovision.
# Dedicated credentials are unused in LOCAL_DEMO; omit them for new demo-only setup.
# Replace placeholders with valid private keys only when intentionally resuming MTN.
MTN_SANDBOX_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SANDBOX_CURRENCY=EUR
MTN_SANDBOX_SUBSCRIPTION_KEY=<PRIVATE_COLLECTIONS_SANDBOX_SUBSCRIPTION_KEY>
MTN_SANDBOX_API_USER_ID=<PRIVATE_PROVISIONED_SANDBOX_API_USER_UUID>
MTN_SANDBOX_API_KEY=<PRIVATE_PROVISIONED_SANDBOX_API_KEY>
# Remove legacy MTN credential entries; never paste production credentials here.
SANDBOX_POLICY_VERSION=SANDBOX-TEST-v1
SANDBOX_MINIMUM=1.00
SANDBOX_STARTER_LIMIT=2.00
SANDBOX_MAXIMUM=20.00
SANDBOX_INTEREST_PERCENT=5.00
SANDBOX_FEE=0.00
SANDBOX_RATE_PER_KWH=1.00
SANDBOX_PURCHASE_PER_POINT=10.00
SANDBOX_PURCHASE_SCORE_CAP=10
SANDBOX_SCORE_THRESHOLD=75
SANDBOX_DUE_DAYS=7
SANDBOX_QUOTE_MINUTES=15
# The original UGX/device pathways remain disabled, including simulated payments.
MOBILE_PAYMENT_ACTIONS_ENABLED=false
MTN_USE_SIMULATED_PAYMENTS=false
SIMULATED_METER_ENABLED=false
PURCHASE_HISTORY_SCORING_ENABLED=false
CELERY_TASK_ALWAYS_EAGER=false
FEATURE_PEER_SHARING_ENABLED=false
FEATURE_METER_TRANSFERS_ENABLED=false
FEATURE_THIRD_PARTY_REPAYMENT_ENABLED=false
FEATURE_USSD_ENABLED=false
FEATURE_WALLET_DEPOSITS_ENABLED=false
FEATURE_WALLET_WITHDRAWALS_ENABLED=false
FEATURE_EXTERNAL_CRB_ENABLED=false

# Separate prototype-only UGX policy. No EUR numeric reuse or currency conversion.
PROTOTYPE_PAYMENT_PROVIDER=LOCAL_DEMO
DEMO_POLICY_VERSION=DEMO-UGX-v2
DEMO_MINIMUM=1000
DEMO_STARTER_LIMIT=5000
# Retained for configuration compatibility only; no starter loan can bypass 80%.
DEMO_MAXIMUM=50000
# DEMO_RATE_PER_KWH is deprecated/ignored for new quotes; configured ElectricityTariff + TariffBlock apply.
DEMO_INTEREST_PERCENT=5
DEMO_FEE=0
DEMO_DUE_DAYS=7
DEMO_QUOTE_MINUTES=15
DEMO_PURCHASE_PER_POINT=10000
DEMO_PURCHASE_SCORE_CAP=10
DEMO_SCORE_THRESHOLD=80
# Synthetic test assumptions, not an approved utility tariff. Delay is fixed >=5s.
# LOCAL_DEMO makes no provider requests. Do not run the old MTN scheduled job.

# Fixed synthetic account-data fixture for newly initialized demo records only.
# No real utility/bank/telecom/CRB retrieval; existing assessments are not overwritten.
DEMO_ACCOUNT_PROFILE=APPROVAL_V1

# Optional new-source keypad-token issuance: see energy-tokens.env.example.
# Configure/back up PRIVATE encryption + stable lookup keys before opting in.
ENERGY_TOKEN_ISSUANCE_ENABLED=false
BENCH_DEVICE_ENABLED=false
